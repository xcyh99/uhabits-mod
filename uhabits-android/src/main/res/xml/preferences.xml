<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
            android:key="importExportCategory"
            android:title="数据导入与导出">

        <Preference
                android:key="exportDB"
                android:summary="@string/export_full_backup_summary"
                android:title="@string/export_full_backup"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="exportLegacyDB"
                android:summary="@string/export_legacy_backup_summary"
                android:title="@string/export_legacy_backup"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="exportCSV"
                android:summary="@string/export_as_csv_summary"
                android:title="@string/export_to_csv"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="importData"
                android:summary="@string/import_data_summary"
                android:title="@string/import_data"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

<PreferenceCategory
            android:key="webDavCategory"
            android:title="WebDAV 云端管理">

        <Preference
                android:key="webDavSync"
                android:title="@string/webdav_sync"
                android:summary="@string/webdav_sync_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

<PreferenceCategory
            android:key="backupCategory"
            android:title="备份与恢复">

        <Preference
                android:key="createFullBackup"
                android:title="创建完整备份"
                android:summary="生成包含习惯、打卡、时间记录和相关设置的完整备份，并可发送到网盘等应用。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="restoreFullBackup"
                android:title="恢复完整备份"
                android:summary="从本机文件或网盘选择完整备份文件，检查后恢复数据。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="exportProgramApk"
                android:title="单独导出本机 APK"
                android:summary="提取并导出手机当前安装的 APP 安装包，可保存到网盘或文件夹，供以后重新安装；不包含习惯和打卡数据，也不需要联网。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="autoBackup"
                android:title="自动备份"
                android:summary="管理自动备份开关、备份间隔、保留数量、保存位置和立即备份。"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

<PreferenceCategory
            android:key="dataSafetyCategory"
            android:title="数据与安全">

        <Preference
                android:key="parameterEmergencyReset"
                android:title="参数紧急恢复"
                android:summary="参数中心异常时，将所有可调参数恢复为安全默认值；不影响习惯、打卡和时间记录。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="clearLocalHabitData"
                android:title="@string/clear_local_habit_data"
                android:summary="@string/clear_local_habit_data_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <Preference
            android:key="sectionDividerFeatureCenter"
            android:selectable="false"
            android:layout="@layout/preference_section_divider"
            app:iconSpaceReserved="false" />

<PreferenceCategory
            android:key="featureCenterCategory"
            android:title="@string/feature_center">

        <Preference
                android:key="desktopWidgetSettings"
                android:title="组件中心"
                android:summary="组件添加、批量添加，以及数字时钟和图片组件设置。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="shortcutManagement"
                android:title="快捷中心"
                android:summary="统一管理功能、设置、习惯、应用和系统快捷入口。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="timeRecords"
                android:title="时间中心"
                android:summary="@string/time_records_summary"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="parameterCenter"
                android:title="参数中心"
                android:summary="集中管理各项可调运行参数；点击后进入参数列表。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="startupPage"
                android:title="启动首页设置"
                android:summary="设置每次打开十字习惯 APP 时首先显示的页面。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="floatingTimer"
                android:title="悬浮计时器"
                android:summary="在其他应用上方显示小时、分钟、秒计时窗口。单击暂停或继续，长按打开设置。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="desktopDoodle"
                android:title="桌面涂鸦"
                android:summary="在当前屏幕上方自由绘画；可切换画笔、橡皮擦、颜色、撤销和清屏，点击关闭退出。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="statusBarDays"
                android:title="状态栏天数"
                android:summary="在状态栏显示一个纯数字；支持打卡间隔、倒计时和正计时。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="puzzleGames"
                android:title="益智游戏"
                android:summary="扫雷、2048、数独、推箱子和飞鸟穿越；离线运行，可关闭音效。"
                app:iconSpaceReserved="false" />






        <Preference
                android:key="desktopShortcuts"
                android:title="桌面快捷"
                android:summary="创建桌面入口，直接打开功能板块、设置板块或具体功能；支持内置图标和相册图片。"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="featureShortcuts"
                android:title="@string/shortcut_settings"
                android:summary="@string/shortcut_settings_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <Preference
            android:key="sectionDividerInterface"
            android:selectable="false"
            android:layout="@layout/preference_section_divider"
            app:iconSpaceReserved="false" />

<PreferenceCategory
            android:key="interfaceCategory"
            android:title="@string/interface_preferences">

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref_short_toggle"
                android:summary="@string/pref_toggle_description_2"
                android:title="@string/pref_toggle_title"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_midnight_delay"
            android:summary="@string/pref_midnight_delay_description"
            android:title="@string/pref_midnight_delay_title"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:defaultValue="3"
            android:dependency="pref_midnight_delay"
            android:entries="@array/midnight_delay_hour_entries"
            android:entryValues="@array/midnight_delay_hour_values"
            android:key="pref_midnight_delay_hours"
            android:summary="@string/pref_midnight_delay_hours_summary"
            android:title="新的一天切换时间"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_skip_enabled"
            android:summary="@string/pref_skip_description"
            android:title="@string/pref_skip_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_unknown_enabled"
            android:summary="@string/pref_unknown_description"
            android:title="@string/pref_unknown_title"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref_checkmark_reverse_order"
                android:summary="@string/reverse_days_description"
                android:title="@string/reverse_days"
                app:iconSpaceReserved="false" />


        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref_pure_black"
                android:summary="@string/pure_black_description"
                android:title="@string/use_pure_black"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_disable_animation"
            android:summary="@string/pref_animations_description"
            android:title="@string/pref_animations_title"
            app:iconSpaceReserved="false" />

        <ListPreference
                android:defaultValue="255"
                android:entries="@array/widget_opacity_entries"
                android:entryValues="@array/widget_opacity_values"
                android:key="pref_widget_opacity"
                android:summary="@string/widget_opacity_description"
                android:title="@string/widget_opacity_title"
                app:iconSpaceReserved="false" />

        <ListPreference
                android:key="pref_first_weekday"
                android:title="@string/first_day_of_the_week"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

<PreferenceCategory
            android:key="reminderCategory"
            android:title="@string/reminder">

        <Preference
                android:key="reminderSound"
                android:title="@string/reminder_sound"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref_sticky_notifications"
                android:summary="@string/sticky_notifications_description"
                android:title="@string/sticky_notifications"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="reminderCustomize"
                android:summary="@string/customize_notification_summary"
                android:title="@string/customize_notification"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <Preference
            android:key="sectionDividerTroubleshooting"
            android:selectable="false"
            android:layout="@layout/preference_section_divider"
            app:iconSpaceReserved="false" />

<PreferenceCategory
            android:key="pref_key_debug"
            android:title="@string/troubleshooting">

        <Preference
                android:key="bugReport"
                android:title="@string/generate_bug_report"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="repairDB"
                android:title="@string/repair_database"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

<PreferenceCategory
            android:key="linksCategory"
            android:title="@string/links">

        <Preference
                android:title="@string/help"
                app:iconSpaceReserved="false">
            <intent
                    android:action="android.intent.action.VIEW"
                    android:data="@string/helpURL" />
        </Preference>

        <Preference
                android:key="rateApp"
                android:title="@string/pref_rate_this_app"
                app:iconSpaceReserved="false">
        </Preference>

        <Preference
                android:title="@string/about"
                app:iconSpaceReserved="false">
            <intent
                    android:action="android.intent.action.VIEW"
                    android:targetClass="org.isoron.uhabits.activities.about.AboutActivity"
                    android:targetPackage="org.isoron.uhabits" />
        </Preference>

    </PreferenceCategory>

<PreferenceCategory
            android:key="devCategory"
            android:title="Development">

        <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="pref_developer"
                android:title="Enable developer mode"
                app:iconSpaceReserved="false" />

        <EditTextPreference
            android:defaultValue="@string/syncBaseURL"
            android:key="pref_sync_base_url"
            android:title="Sync server"
            app:iconSpaceReserved="false"
            />

        <EditTextPreference
            android:defaultValue=""
            android:key="pref_sync_key"
            android:title="Sync key"
            app:iconSpaceReserved="false"
            />

        <EditTextPreference
            android:defaultValue=""
            android:key="pref_encryption_key"
            android:title="Encryption key"
            app:iconSpaceReserved="false"
            />

    </PreferenceCategory>


</PreferenceScreen>
