<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digital_clock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:background="@drawable/time_record_widget_background">
    <FrameLayout
        android:id="@+id/digital_clock_time_viewport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clipChildren="true"
        android:clipToPadding="true">
        <FrameLayout
            android:id="@+id/digital_clock_time_mover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="true"
            android:clipToPadding="true">
            <TextClock
        android:id="@+id/digital_clock_time"
        android:layout_width="match_parent"\n                    android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="h"
        android:format24Hour="HH"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:maxLines="1" />
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/digital_clock_gap1"
        android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:text="" android:includeFontPadding="false" android:minHeight="0dp" android:textSize="1sp" />
    <FrameLayout
        android:id="@+id/digital_clock_minute_viewport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clipChildren="true"
        android:clipToPadding="true">
        <FrameLayout
            android:id="@+id/digital_clock_minute_mover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="true"
            android:clipToPadding="true">
            <TextClock
        android:id="@+id/digital_clock_minute"
        android:layout_width="match_parent"\n                    android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:maxLines="1" />
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/digital_clock_gap2"
        android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:text="" android:includeFontPadding="false" android:minHeight="0dp" android:textSize="1sp" />
    <FrameLayout
        android:id="@+id/digital_clock_date_viewport"
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:clipChildren="true"
        android:clipToPadding="true">
        <FrameLayout
            android:id="@+id/digital_clock_date_mover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="true"
            android:clipToPadding="true">
            <TextClock
        android:id="@+id/digital_clock_date"
        android:layout_width="match_parent"\n                    android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="M月d日  EEEE"
        android:format24Hour="M月d日  EEEE"
        android:textColor="#DDFFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1" />
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/digital_clock_gap3"
        android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:text="" android:includeFontPadding="false" android:minHeight="0dp" android:textSize="1sp" />
    <LinearLayout
        android:id="@+id/digital_clock_shortcut_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/digital_clock_shortcut1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut1_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式1"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut2_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式2"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut3_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式3"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut4_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式4"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut5_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式5"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut6_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式6"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut7_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式7"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut8_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="64dp"
                android:maxHeight="64dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式8"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
