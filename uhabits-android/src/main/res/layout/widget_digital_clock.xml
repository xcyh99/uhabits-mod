<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digital_clock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="7dp"
    android:background="@drawable/time_record_widget_background">

    <!-- Row 1: hour. TextClock remains system-managed for low-power updates. -->
    <TextClock
        android:id="@+id/digital_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="h"
        android:format24Hour="HH"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:maxLines="1" />

    <!-- Row 2: minute, independently styled but automatically refreshed by Android. -->
    <TextClock
        android:id="@+id/digital_clock_minute"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:maxLines="1" />

    <!-- Row 3: calendar date and weekday. -->
    <TextClock
        android:id="@+id/digital_clock_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="M月d日  EEEE"
        android:format24Hour="M月d日  EEEE"
        android:textColor="#DDFFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <!-- Row 4: four reusable shortcut positions. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/digital_clock_shortcut1"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_menu_call"
                android:contentDescription="快捷方式一"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷1"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/digital_clock_shortcut2"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_dialog_email"
                android:contentDescription="快捷方式二"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷2"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/digital_clock_shortcut3"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式三"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷3"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:id="@+id/digital_clock_shortcut4"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="快捷方式四"
                android:tint="#FFFFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷4"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
