<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digital_clock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="7dp"
    android:background="@drawable/time_record_widget_background">
    <TextClock
        android:id="@+id/digital_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="h"
        android:format24Hour="HH"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:maxLines="1" />
    <TextClock
        android:id="@+id/digital_clock_minute"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="mm"
        android:format24Hour="mm"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="sans-serif"
        android:maxLines="1" />
    <TextClock
        android:id="@+id/digital_clock_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65"
        android:gravity="center"
        android:includeFontPadding="false"
        android:format12Hour="M月d日  EEEE"
        android:format24Hour="M月d日  EEEE"
        android:textColor="#DDFFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1" />
    <LinearLayout
        android:id="@+id/digital_clock_shortcut_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="8">
        <LinearLayout
            android:id="@+id/digital_clock_shortcut1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut1_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式1"
                android:tint="#FFFFFFFF" />
            <TextView
                android:id="@+id/digital_clock_shortcut1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷1"
                android:textColor="#CCFFFFFF"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut2_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式2"
                android:tint="#FFFFFFFF" />
            <TextView
                android:id="@+id/digital_clock_shortcut2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷2"
                android:textColor="#CCFFFFFF"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut3_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式3"
                android:tint="#FFFFFFFF" />
            <TextView
