        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut5_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式5"
                android:tint="#FFFFFFFF" />
            <TextView
                android:id="@+id/digital_clock_shortcut5_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷5"
                android:textColor="#CCFFFFFF"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut6_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="快捷方式6"
                android:tint="#FFFFFFFF" />
            <TextView
                android:id="@+id/digital_clock_shortcut6_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="快捷6"
                android:textColor="#CCFFFFFF"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/digital_clock_shortcut7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">
            <ImageView
                android:id="@+id/digital_clock_shortcut7_icon"
                android:layout_width="23dp"
                android:layout_height="23dp"
