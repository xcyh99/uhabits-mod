<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/picture_shortcut_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="图片快捷组件" />
    <ImageView
        android:id="@+id/picture_shortcut_image_stretch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="图片快捷组件" />
    <ImageView
        android:id="@+id/picture_shortcut_image_crop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="图片快捷组件" />
    <TextView
        android:id="@+id/picture_shortcut_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="请设置图片"
        android:textColor="#FFFFFFFF"
        android:background="#FF30343B"
        android:textSize="14sp" />
    <!-- Four independent touch zones. Their weighted row/column sizes are
         updated by the X/Y split values in PictureShortcutWidgetProvider. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:weightSum="10">
                <TextView
                    android:id="@+id/picture_zone_top_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:text=""
                    android:textSize="1sp"
                    android:padding="0dp" />
                <TextView
                    android:id="@+id/picture_zone_top_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:text=""
                    android:textSize="1sp"
                    android:padding="0dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:weightSum="10">
                <TextView
                    android:id="@+id/picture_zone_bottom_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:text=""
                    android:textSize="1sp"
                    android:padding="0dp" />
                <TextView
                    android:id="@+id/picture_zone_bottom_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:text=""
                    android:textSize="1sp"
                    android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
