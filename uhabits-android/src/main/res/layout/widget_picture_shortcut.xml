<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/picture_shortcut_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="图片快捷组件" />
    <TextView
        android:id="@+id/picture_shortcut_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="请设置图片"
        android:textColor="#FFFFFFFF"
        android:background="#FF30343B"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="10">
        <TextView android:id="@+id/picture_zone_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
        <TextView android:id="@+id/picture_zone_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:text="" android:textSize="1sp" android:padding="0dp" />
    </LinearLayout>
</FrameLayout>
