<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/weather_widget_background">

    <FrameLayout
        android:id="@+id/weather_tiny_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextView
            android:id="@+id/weather_tiny_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:maxWidth="48dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="合肥"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_tiny_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="晴"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_tiny_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="3dp"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/weather_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#332F4864">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="合肥"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weather_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="更新于 --:--"
                android:textColor="#AEB9C8"
                android:textSize="8sp"
                android:textStyle="normal" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#667D91A8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.2"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_current_desc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="晴"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weather_current_temp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="--°"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#667D91A8" />

        <LinearLayout
            android:id="@+id/weather_detail_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4.1"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="湿度" android:textColor="#D7DFEA" android:textSize="8sp" />
                <TextView android:id="@+id/weather_humidity_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="--%" android:textColor="#FFFFFF" android:textSize="8sp" />
            </LinearLayout>
            <TextView android:layout_width="1dp" android:layout_height="26dp" android:background="#667D91A8" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="风速" android:textColor="#D7DFEA" android:textSize="8sp" />
                <TextView android:id="@+id/weather_wind_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="--" android:textColor="#FFFFFF" android:textSize="8sp" />
            </LinearLayout>
            <TextView android:layout_width="1dp" android:layout_height="26dp" android:background="#667D91A8" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="降水" android:textColor="#D7DFEA" android:textSize="8sp" />
                <TextView android:id="@+id/weather_rain_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="--%" android:textColor="#FFFFFF" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_day_desc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:gravity="center">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_0" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_0" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_0" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_1" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_1" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_1" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_2" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_2" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_2" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_3" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_3" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_3" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_4" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_4" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_4" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_5" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_5" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_5" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_6" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:includeFontPadding="false" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_icon_6" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:includeFontPadding="false" android:text="☀️" android:textSize="22sp" android:maxLines="1" />
            <TextView android:id="@+id/weather_desc_6" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:includeFontPadding="false" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp" android:maxLines="2" android:lineSpacingExtra="0dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/weather_chart_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="1dp"
        android:background="#665B7088" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp">
        <ImageView
            android:id="@+id/weather_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="未来七天最高温和最低温趋势图" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_0" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_1" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_2" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_3" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_4" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_5" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_hit_6" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/weather_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="" />
</LinearLayout>
