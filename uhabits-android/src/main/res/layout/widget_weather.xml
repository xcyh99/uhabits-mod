<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/weather_widget_background">

    <FrameLayout
        android:id="@+id/weather_tiny_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextView
            android:id="@+id/weather_tiny_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:text="合肥"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_tiny_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="晴"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_tiny_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="4dp"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/weather_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42dp">
        <TextView
            android:id="@+id/weather_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:text="合肥"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_current_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="晴"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/weather_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:text="天气数据"
        android:textColor="#AEB9C8"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/weather_day_desc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:gravity="center">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="明天" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="周三" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1" android:text="周四" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="周五" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="周六" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/weather_day_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="周日" android:textColor="#FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/weather_icon_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18sp"/>
            <TextView android:id="@+id/weather_desc_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#E8EDF5" android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="0dp"
        android:layout_weight="1"
        android:layout_marginTop="0dp">
        <ImageView
            android:id="@+id/weather_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="未来七天最高温和最低温趋势图" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_0" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_0" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_0" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_1" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_2" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_3" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_4" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_5" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/weather_chart_high_6" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_chart_low_6" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom|center_horizontal" android:includeFontPadding="false" android:text="--°" android:textColor="#E8EDF5" android:textSize="9sp" />
                <TextView android:id="@+id/weather_hit_6" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/weather_bottom_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="0dp"
        android:text="湿度 --%   风速 --"
        android:textColor="#D7DFEA"
        android:textSize="10sp" />
</LinearLayout>
