<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/big_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/time_record_widget_background">

    <LinearLayout
        android:id="@+id/big_clock_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/big_clock_mode_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="时间"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
        <TextClock
            android:id="@+id/big_clock_wall_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:format12Hour="h:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1" />
        <Chronometer
            android:id="@+id/big_clock_chronometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:format="%s"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <TextView
            android:id="@+id/big_clock_tab_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="7dp"
            android:text="时间"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/big_clock_tab_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="7dp"
            android:text="正计时"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/big_clock_tab_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="7dp"
            android:text="倒计时"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
