<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="wrap_content"
    tools:layout_width="match_parent"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/descriptionTitle"
        style="@style/CardHeader"
        android:layout_marginBottom="12dp"
        android:text="@string/show_description_notes"
        android:visibility="gone"
        tools:text="说明备注" />

    <TextView
        android:id="@+id/habitNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/contrast100"
        tools:text="This is some example text for the habit description" />

    <TextView
        android:id="@+id/historyNotesTitle"
        style="@style/CardHeader"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        tools:text="历史备注" />

    <ScrollView
        android:id="@+id/historyNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:nestedScrollingEnabled="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/historyNotesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</merge>