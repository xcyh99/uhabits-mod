<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/weather_widget_root"
    android:orientation="vertical"
    android:background="#E9222935">

    <LinearLayout
        android:id="@+id/weather_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#332F4864">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="合肥"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weather_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="更新于 --:--"
                android:textColor="#AEB9C8"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#667D91A8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.2"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_current_desc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="晴"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weather_current_temp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="--°"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#667D91A8" />

        <LinearLayout
            android:id="@+id/weather_detail_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4.1"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="湿度"
                    android:textColor="#D7DFEA"
                    android:textSize="8sp" />
                <TextView
                    android:id="@+id/weather_humidity_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="--%"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp" />
            </LinearLayout>
            <TextView
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:background="#667D91A8" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="风速"
                    android:textColor="#D7DFEA"
                    android:textSize="8sp" />
                <TextView
                    android:id="@+id/weather_wind_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp" />
            </LinearLayout>
            <TextView
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:background="#667D91A8" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="降水"
                    android:textColor="#D7DFEA"
                    android:textSize="8sp" />
                <TextView
                    android:id="@+id/weather_rain_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="--%"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_day_desc_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_0"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="今天"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_0"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="☀"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_0"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="22°/13°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_1"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周日"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_1"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="☁"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_1"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="20°/12°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_2"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周一"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_2"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="🌦"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="18°/11°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_3"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周二"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_3"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="☀"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_3"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="21°/12°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_4"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周三"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_4"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="☁"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_4"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="23°/14°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_5"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周四"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_5"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="🌧"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_5"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="19°/10°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/weather_day_6"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="周五"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/weather_icon_6"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="☀"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/weather_desc_6"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="22°/13°"
                android:textColor="#E8EDF5"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_line_test_area"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/weather_high_line"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:fontFamily="monospace"
            android:lineSpacingExtra="-0.4dp"
            android:maxLines="7"
            android:text=""
            android:textColor="#F6B65D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weather_low_line"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:fontFamily="monospace"
            android:lineSpacingExtra="-0.4dp"
            android:maxLines="7"
            android:text=""
            android:textColor="#78BCEB"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>