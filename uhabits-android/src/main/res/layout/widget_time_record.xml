<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/time_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/time_record_widget_background">

    <TextView
        android:id="@+id/time_record_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/time_record_number"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:fontFamily="sans-serif-condensed"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="26sp"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeStepGranularity="1sp"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/time_record_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#CCFFFFFF"
        android:textSize="9sp" />
</LinearLayout>
