<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="org.isoron.uhabits.HabitsApplication"
        android:allowBackup="true"
        android:backupAgent="org.isoron.uhabits.HabitsBackupAgent"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/main_activity_title"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppBaseTheme">

        <activity
            android:name="org.isoron.uhabits.activities.habits.edit.EditHabitActivity"
            android:exported="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.isoron.uhabits.activities.habits.list.ListHabitsActivity" />
        </activity>

        <meta-data
            android:name="com.google.android.backup.api_key"
            android:value="AEdPqrEAAAAI6aeWncbnMNo8E5GWeZ44dlc5cQ7tCROwFhOtiw" />

        <activity
            android:name="org.isoron.uhabits.activities.habits.list.ListHabitsActivity"
            android:exported="true"
            android:label="@string/main_activity_title"
            android:launchMode="singleTask" />

        <activity-alias
            android:name="org.isoron.uhabits.MainActivity"
            android:exported="true"
            android:label="@string/main_activity_title"
            android:launchMode="singleTask"
            android:targetActivity="org.isoron.uhabits.activities.habits.list.ListHabitsActivity">
            <intent-filter android:label="@string/main_activity_title">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="org.isoron.uhabits.activities.habits.show.ShowHabitActivity"
            android:label="@string/title_activity_show_habit">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.isoron.uhabits.activities.habits.list.ListHabitsActivity" />
        </activity>

        <activity
            android:name="org.isoron.uhabits.activities.timerecords.TimeRecordsActivity"
            android:label="@string/time_records">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.isoron.uhabits.activities.habits.list.ListHabitsActivity" />
        </activity>

        <activity
            android:name="org.isoron.uhabits.widgets.TimeRecordWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.isoron.uhabits.activities.settings.SettingsActivity"
            android:label="@string/settings"
            android:launchMode="singleTop">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.isoron.uhabits.activities.habits.list.ListHabitsActivity" />
        </activity>

        <activity
            android:name="org.isoron.uhabits.activities.intro.IntroActivity"
            android:label=""
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name="org.isoron.uhabits.widgets.activities.HabitPickerDialog"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.isoron.uhabits.widgets.activities.BooleanHabitPickerDialog"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.isoron.uhabits.widgets.activities.NumericalHabitPickerDialog"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.Dialog.Alert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.isoron.uhabits.activities.about.AboutActivity"
            android:label="@string/about">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="org.isoron.uhabits.activities.habits.list.ListHabitsActivity" />
        </activity>

        <activity
            android:name="org.isoron.uhabits.notifications.SnoozeDelayPickerActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name="org.isoron.uhabits.widgets.CheckmarkWidgetProvider"
            android:exported="true"
            android:label="@string/checkmark">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_checkmark_info" />
        </receiver>

        <service
            android:name="org.isoron.uhabits.widgets.StackWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name="org.isoron.uhabits.widgets.HistoryWidgetProvider"
            android:exported="true"
            android:label="@string/history">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_history_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.ScoreWidgetProvider"
            android:exported="true"
            android:label="@string/score">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_score_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.TimeRecordWidgetProvider"
            android:exported="true"
            android:label="@string/time_records_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_time_record_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.WidgetPinQueueReceiver"
            android:exported="false" />

        <receiver
            android:name="org.isoron.uhabits.widgets.BatchAddWidgetProvider"
            android:exported="true"
            android:label="@string/batch_add_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_batch_add_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.DaysSinceLastCheckinWidgetProvider"
            android:exported="true"
            android:label="@string/days_since_last_checkin">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_days_since_last_checkin_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.StreakWidgetProvider"
            android:exported="true"
            android:label="@string/streaks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.FrequencyWidgetProvider"
            android:exported="true"
            android:label="@string/frequency">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_frequency_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.widgets.TargetWidgetProvider"
            android:exported="true"
            android:label="@string/target">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_target_info" />
        </receiver>

        <receiver
            android:name="org.isoron.uhabits.receivers.ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name="org.isoron.uhabits.receivers.WidgetReceiver"
            android:exported="true"
            android:permission="false">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="org.isoron.uhabits.ACTION_SET_NUMERICAL_VALUE" />
                <data
                    android:host="org.isoron.uhabits"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="org.isoron.uhabits.ACTION_TOGGLE_REPETITION" />

                <data
                    android:host="org.isoron.uhabits"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="org.isoron.uhabits.ACTION_ADD_REPETITION" />

                <data
                    android:host="org.isoron.uhabits"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="org.isoron.uhabits.ACTION_REMOVE_REPETITION" />

                <data
                    android:host="org.isoron.uhabits"
                    android:scheme="content" />
            </intent-filter>
        </receiver>

        <!-- Locale/Tasker -->
        <activity
            android:name="org.isoron.uhabits.automation.EditSettingActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Locale/Tasker -->
        <receiver
            android:name="org.isoron.uhabits.automation.FireSettingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
            <receiver
            android:name="org.isoron.uhabits.notifications.StatusBarDaysReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="org.isoron.uhabits.action.UPDATE_STATUS_BAR_DAYS" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name="org.isoron.uhabits.activities.settings.FloatingTimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的悬浮计时器" />
        </service>

        <service
            android:name="org.isoron.uhabits.activities.settings.DesktopDoodleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的屏幕涂鸦悬浮层" />
        </service>

    </application>

</manifest>
